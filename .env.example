# Läuft ausschließlich lokal. Die sevdesk-Adresse stammt aus der offiziellen Hilfeseite.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT=8192
# Bei großen Postfächern zunächst klein beginnen.
GMAIL_QUERY=newer_than:7d -in:spam -in:trash
MAX_MESSAGES_PER_RUN=20
# Gmail Konto muss mit sevdesk-Registrierung übereinstimmen, sonst kein Versand.
SEVDESK_REGISTERED_EMAIL=
SEVDESK_EMAIL=autobox@sevdesk.email
# Erst nach erfolgreich durchgeführtem OAuth-Sendeschritt auf 1 setzen.
ENABLE_SEND=0
# 0 = nie automatisch weiterleiten (der einzig unterstützte Betrieb)
AUTO_SEND=0
# Für Paperclip HTTP Webhook: langes eigenes Secret setzen (openssl rand -hex 32).
PAPERCLIP_WEBHOOK_SECRET=
WEB_PORT=8765
